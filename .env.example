# Supabase — requis dès maintenant (étapes 1-2)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site — requis dès maintenant
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Storage — requis dès maintenant
NEXT_PUBLIC_STORAGE_BUCKET=desserts-images

# ============================================================
# Module réservation brunch — requis à partir de l'étape 4 (emails)
# et de l'étape 3 (anti-robot). Sans valeur, le formulaire public
# et les emails ne fonctionneront pas, mais /admin/settings et
# /admin/creneaux (étape 2) n'en ont pas besoin.
# ============================================================

# Emails (Resend)
RESEND_API_KEY=
EMAIL_FROM="L'Intemporel <reservations@votre-domaine.fr>"

# Anti-robot (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Limitation de débit — chaîne aléatoire, sel du hash d'IP (ex: openssl rand -hex 16)
RATE_LIMIT_SEL=
